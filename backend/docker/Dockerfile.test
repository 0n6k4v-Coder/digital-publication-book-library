FROM rust:1.98.1-bookworm

RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

ENV CARGO_TERM_COLOR=always \
    RUST_BACKTRACE=1 \
    CARGO_TARGET_DIR=/workspace/target

CMD ["cargo", "test", "--tests", "--no-fail-fast"]